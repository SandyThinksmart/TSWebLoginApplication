@using TSWebLoginApplication.Domain.Resources
@inject LocalizationServices LocalizationServices
@{
    ViewData["Title"] = @LocalizationServices.GetLocalizedHtmlString("lbl_MenuPage");
    Layout = "~/Views/Shared/_Layout.cshtml";
    string user = ViewBag.AuthorizedUser;
    string aspxurl = ViewBag.aspxurl;
  
   }
<style type="text/css">
       .Hidden {
        display: none;
    }
</style>
@section Scripts{
     <script type="text/javascript" src="~/Static/js/jquery-2.1.1.min.js"></script>
  <script type="text/javascript" src="~/js/Administrator.js"></script>
     <script type="text/javascript" src="~/Static/js/common.js"></script>
  <script type="text/javascript" src="~/Static/js/CommonScript.js"></script>

  <link href="~/Static/css/Common.css" rel="stylesheet" />
  <link href="~/Static/css/MenuScreen1.css" rel="stylesheet" />
    <link href="~/css/masterStyles.css" rel="stylesheet" />

  
                  }

                                               
                  <body style="background-color:#f0f0f0;">
<form id="form1">

    
    <br />
        <br />


            <div style="width:100%">

                <div id="menuWrapper" style="background-color:#f0f0f0;"> @*margin: 0 auto; removed*@
                    <table>
                        <tr>
                            <td align="left" style="border-style:none">
                                <input type="button" style="color:#007bff;border-style:none;font-size:15px;margin-left:-8px;" value="@LocalizationServices.GetLocalizedHtmlString("lbl_MenuPage1")" ID="btnClose"
                                   TabIndex="1" class="labelClass" />

                            </td>
                        </tr>
                    </table>
                    <div id="menuHeader" style="padding-top:7px;text-align:left">

                        <table width="100%" cellpadding="1" cellspacing="1">
                            <tr>
                                <td align="left" style="border-style:none">
                                    @*<label id="lblmainmenu" class="labelClass" style="color:white;margin-left:5px;">@LocalizationServices.GetLocalizedHtmlString("lbl_MenuPage")</label>*@
                                    <label id="lblworkstation" class="labelClass" style="color:white;margin-left:5px;">@LocalizationServices.GetLocalizedHtmlString("lbl_workstation"):</label>
                                    <label id="lblusername" class="labelClass" style="color:white;"></label>

                                </td>
                                <td align="right" style="border-style:none">
                                    <input type="button" id="btnsignout" onclick="logout($(this));" style="display:none;font-size:14px;background-color:#336699;border-style:none;width:90px;color:white;" class="labelClass" value="@LocalizationServices.GetLocalizedHtmlString("lbl_SignOut")" />
                                </td>
                            </tr>

                        </table>


                    </div>
                    <table style="width: 100%;Margin-top:5px" cellspacing="0" cellpadding="0">
                        <tbody>
                            <tr>

                                <td valign="top" colspan="3">
                                    <div id="pnlSubMenu" class="subMenu">

                                        <div id="divMaster" class="uppercontainer divDefault" style="position: relative; display: block; width: 100%; height: 27%;">
                                            <table class="MenuTable" cellpadding="1" cellspacing="1" style="position: relative; width: 100%; height: 22%; top: 0px; left: 0px;">
                                                <tbody>
                                                <tr class="tdclass">
                                                    <td class="style3">&nbsp; </td>
                                                </tr>
                                                    <tr class="tdclass">
                                                        <td class="style2" style="padding-top:10px;padding-bottom:5px;text-align:center">
                                                            <span id="lblCreateUser" data-url="Login/CreateUser.aspx" class="linkFormat">ワークステーションの作成・修正<br>Create New Workstation</span>
                                                        </td>
                                                    </tr>
                                                    <tr class="tdclass">
                                                        <td class="style2" style="padding-top:10px;padding-bottom:5px;text-align:center">
                                                            <span id="lblChangePassword" data-url="Login/ChangePassword.aspx" class="linkFormat">パスワードの変更<br>Change Password</span>
                                                        </td>
                                                    </tr>
                                                   
                                                   
                                                    <tr class="tdclass" style="display:none;">
                                                        <td class="style2" style="padding-top:10px;padding-bottom:5px;text-align:center">
                                                            <span id="lblLocationEntry" data-url="Masters/M_LocationEntry.aspx" class="linkFormat">@Html.Raw(@LocalizationServices.GetLocalizedHtmlString("lblMenu_LocationMaster").ToString().Replace("</br>", "<br>"))</span>
                                                        </td>
                                                    </tr>

                                                </tbody>
                                            </table>
                                        </div>

                                    </div>

                                </td>
                            </tr>
                        </tbody>
                    </table>
                 @*   <table style="width: 700px;margin-top:5px" cellspacing="0" cellpadding="0">
                        <tr>
                            <td align="right" style="border-style:none;">
                                <div id="menuFooter">
                                    <div id="DivCloseButton" style="height: 57px">
                                        <div id="divLblClose">
                                            <label id="lblClose" class="labelClass" style="color:white">@LocalizationServices.GetLocalizedHtmlString("lbl_CloseWindow")</label>

                                        </div><div id="divBtnClose">
                                            <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("btn_Close_L")" ID="btnClose"
                                               style="color:black" TabIndex="16" class="_functionButtons labelClass" />
                                        </div>
                                    </div>
                                </div>

                            </td>

                        </tr>
                    </table>*@
                </div>
            </div>
            <input type="hidden" id="authorizeduser" name="authorizeduser" value="@user" />
            <input type="hidden" id="aspxurl" name="aspxurl" value="@aspxurl" />
                      
            <div id="divErrorMessages" class="Hidden">

                <label id="lblErrorMessageE_systemexception" class="Hidden">
                    <span ID="LiteralExceptionOccured">@LocalizationServices.GetLocalizedHtmlString("valMsg_COM_SystemException")</span>
                </label>

            </div>
           
</form>
</body>