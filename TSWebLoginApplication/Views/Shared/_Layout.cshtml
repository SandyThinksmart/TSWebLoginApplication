@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
@{
    
    string userName = @Configuration.GetSection("DummyUserData")["userName"];
    string password = @Configuration.GetSection("DummyUserData")["Password"];
    string apiurl = @Configuration.GetSection("LOGINAPIURL")["APIURL"];
    string hosturl = @Configuration.GetSection("HOSTINVOICE")["HOSTURL"];
    string ftphosturl = @Configuration.GetSection("FTPHOSTINVOICE")["FTPHOSTURL"];
    string pmsurl = @Configuration.GetSection("PMSCORE")["COREURL"];
    string aspurl = @Configuration.GetSection("PMSASPX")["ASPXURL"];
   
}
   <head>
    <meta name="google" content="notranslate" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TSWebLoginApplication</title>
       <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
           <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    
</head>
<body>
  <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                           
                <ul class="ml-auto" style="margin-bottom:revert;margin-bottom:0">
                    <li>
                        @await Html.PartialAsync("_SetLanguagePartialView")
                    </li>

                </ul>
            </div>
        </nav>

  </header>
    <div class="container">
        <main role="main" class="pb-3">
            <input type="hidden" id="apiurlvalue" value="@apiurl"/>
            <input type="hidden" id="dummyUserName" value="@userName" />
            <input type="hidden" id="dummyPassword" value="@password" />
            <input type="hidden" id="hosturl" value="@hosturl" />
            <input type="hidden" id="ftphosturl" value="@ftphosturl" />
            <input type="hidden" id="hdfpmsurl" value="@pmsurl" />
            <input type="hidden" id="hdfaspurl" value="@aspurl" />
            @RenderBody()
        </main>
    </div>
    
    
   
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/date.format.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.10/jquery.mask.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">
    <script src="~/lib/bootbox/bootbox.min.js"></script>
    <script>
        var APIURL = $("#apiurlvalue").val();
        var dummyUserName = $("#dummyUserName").val();
        var dummyPassword = $("#dummyPassword").val();
   //var APIURL="https://202.0.103.130:92";
    </script>

    @RenderSection("Scripts", required: false)

  @*  @await RenderSectionAsync("Scripts", required: false)*@
</body>
</html>
