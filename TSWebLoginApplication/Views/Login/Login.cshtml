@using TSWebLoginApplication.Domain.Resources
@inject LocalizationServices LocalizationServices
@{
    ViewData["Title"] = "Login Page";

    Layout = "~/Views/Shared/_Layout.cshtml";
    string user = ViewBag.AuthorizedUser;
}

<link href="~/css/Common_Styles.css" rel="stylesheet" />
<link href="~/css/masterStyles.css" rel="stylesheet" />

<style type="text/css">
    .Hidden {
        display: none;
    }
    #LoadingImage {
  position: fixed;
  display: block;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  text-align: center;
  opacity: 0.7;
  background-color: #fff;
  z-index: 99;
  padding-top:15%;
}

#loadimage {
  position: absolute;
  padding-top:40%;
  top: 100px;
  left: 280px;
  z-index: 100;

}

    .password-container {
        width: 155px;
        position: relative;
    }

        .password-container input[type="password"],
        .password-container input[type="text"] {
            width: 100%;
            padding: 5px 15px 5px 5px;
            box-sizing: border-box;
        }
       
    .fa-eye {
        position: absolute;
        top: 28%;
        right: 4%;
        cursor: pointer;
        color: dimgray;
        font-size:small;
    }
</style>
<form id="form1">
        <div style="text-align: center; width: 100%;margin-top:20px">
            <table align="center" cellpadding="1" cellspacing="1" frame="box" bgcolor="#EFEFEF">
                <tr>
                    <td>
                    </td>
                </tr>
                <tr>
                    <td>
                        <table align="center">
                            <tr>
                                <td style="text-align: center;">
                                    <table cellpadding="0" style="height: 140px; width: 250px;">
                                        <tr>
                                            <td align="left" bgcolor="#336699" colspan="2" style="text-align: center" class="style6">

                                                <label ID="lblLogin" class="labelClass" style="color:white;">@LocalizationServices.GetLocalizedHtmlString("lbl_LogIn")</label>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td align="left" class="style5">

                                                <label ID="lblworkstation" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_workstation")</label>
                                            </td>
                                            <td class="style5">

                                            <input type="text" ID="txtUserName" TabIndex="1" class="labelClass"
                                                   style="width:150px;height:22px;" MaxLength="15" errorLabel="@LocalizationServices.GetLocalizedHtmlString("valMsg_WorkstationPasswordIncorrect")">
                                                <span class="text-danger" style="display:none">@LocalizationServices.GetLocalizedHtmlString("valMsg_WorkstationPasswordIncorrect")</span>
                                            </td>
                                            <td>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td align="left" class="style5">
                                                <label ID="lblpassword" class="labelClass" style="width:150px">@LocalizationServices.GetLocalizedHtmlString("lbl_Password")</label>
                                            </td>
                                            <td class="style5">

                                            <div class="password-container">
                                                <input type="password" ID="txtPassword" TabIndex="1" class="labelClass"
                                                       style="width:150px;height:22px;font-size:15px;" MaxLength="15">
                                                <i class="fa-solid fa-eye" id="eye"></i>
                                            </div>
                                            

                                            </td>
                                            <td>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td align="center" colspan="2" style="color: Red;">
                                            </td>
                                        </tr>

                                        <tr>
                                            <td align="center" colspan="2">


                                                <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("lbl_LogIn")" ID="LoginButton"
                                                   TabIndex="16" class="_functionButtons labelClass" />
                                            <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("lbl_LogIn")" ID="Button1"
                                            style="width:100px;display:none;" TabIndex="16" class="_functionButtons"/>
                                                @*onclick="location.href='@Url.Action("ValidateUser", "LoginPage")?id='"*@

                                            <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("lbl_Initialize")" ID="btnInitialize"
                                                   TabIndex="16" class="_functionButtons labelClass" />
                                            </td>
                                        </tr>
                                    </table>


                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        <input type="hidden" id="authorizeduser" name="authorizeduser" value="@user" />
        </div>
        <div id="divErrorMessages" class="Hidden">
            <label id="lblErrorMessageE_LoginUserName" class="Hidden">
                <span ID="LiteralExceptionOccured" style="margin-left:5px">@LocalizationServices.GetLocalizedHtmlString("valMsg_WorkstationPasswordIncorrect")</span>
            </label>
        <label id="lblErrorMessageE_systemexception" class="Hidden">
            <span ID="LiteralExceptionOccured">@LocalizationServices.GetLocalizedHtmlString("valMsg_COM_SystemException")</span>
        </label>

        </div>

    <div id="LoadingImage" style="display: none">
        <img id="loadImage" src="~/images/loading.gif" height="60px" width="60px"/>
    </div>
    </form>
@section Scripts{
    <script type="text/javascript" src="~/js/Login.js"></script>
    

}